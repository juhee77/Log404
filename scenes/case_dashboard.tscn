[ext_resource type="PackedScene" path="res://scenes/evidence_board.tscn" id="3"]
[ext_resource type="PackedScene" path="res://scenes/final_report.tscn" id="4"]

[node name="CaseDashboard" type="Control"]
layout_mode = 3
anchors_preset = 15
